{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "prettier --write \"$CLAUDE_FILE_PATH\" 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "eslint --fix \"$CLAUDE_FILE_PATH\" 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "npx tsc --noEmit 2>&1 | head -20 || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"$CLAUDE_FILE_PATH\" | grep -qE '\\.(test|spec)\\.(ts|tsx|js|jsx)$|/__tests__/' && echo 'BLOCKED: Do not modify test files. Fix the implementation instead.' && exit 2 || exit 0"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "npm run *",
      "npx *",
      "git add *",
      "git commit *",
      "git push *",
      "git checkout *",
      "git branch *",
      "git fetch *",
      "git rebase *",
      "git diff *",
      "git log *",
      "git status",
      "prettier *",
      "eslint *"
    ],
    "deny": [
      "rm -rf /",
      "DROP TABLE",
      "DELETE FROM * WHERE 1=1"
    ]
  }
}
